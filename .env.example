# Required at build time — Vite only exposes variables prefixed with VITE_.
# Every value here is inlined into the client bundle, so they are all public.
# Set these in your host's environment (e.g. Render service settings); do NOT
# rely on a local .env in production.

# Backend API base
VITE_PUBLIC_API_URL=https://protrackapi.casdnet.com/promall/api

# Base URL product images are served from
VITE_IMAGE_BASE_URL=https://resellersinventory.casdnet.com/

# Public payment keys — safe to expose, but use the LIVE keys in production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx-X

# Base URL of the Django CMS proxy; the app appends the combined endpoint.
VITE_PROMALL_PROXY_URL=http://127.0.0.1:8001/proxy